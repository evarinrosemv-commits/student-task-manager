# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# Local: mongodb://localhost:27017/student_task_manager
# Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/student_task_manager?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/student_task_manager

# JSON Web Token Secret (replace with a long, random secure string)
JWT_SECRET=student_task_manager_super_secure_jwt_secret_key_2026

# Token expiration (e.g. 1d, 7d, 30d)
JWT_EXPIRES_IN=7d

# Allowed Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
